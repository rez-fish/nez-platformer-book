<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Spirefall</RootNamespace>
    <AssemblyName>Spirefall</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- Nez and FNA are referenced as pinned source checkouts in sibling folders.
       Nez.FNA.Core already references FNA.Core; the direct FNA reference is
       explicit so the pairing is visible. See /AI_NOTES.md for pinned commits. -->
  <!-- Gum.FNA 2026.10.1.1 verified on nuget.org 2026-10-06.
       Gum source pinned @ dbb35814 for API reference. -->
  <ItemGroup>
    <PackageReference Include="Gum.FNA" Version="2026.10.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FNA\FNA.Core.csproj" />
    <ProjectReference Include="..\Nez\Nez.Portable\Nez.FNA.Core.csproj" />
  </ItemGroup>

  <!-- Everything under Content/ (tilemaps, tilesets, audio, …) is copied next
       to the built exe, preserving folders. Nez loads it via Content.Load*. -->
  <ItemGroup>
    <Content Include="Content\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
